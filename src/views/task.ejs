<%- include('./includes/header')%>
<%- include('./includes/nav')%>

<%- include('./includes/messages') %>

 <main>
      <header>
        <span>Project / Dev Projects</span>
        <h1>Board</h1>
      </header>
      <!-- COLUNAS -->
      <section class="columns" dataToken="<%= csrfToken %>">

        <section class="column">
          <h2 class="column_title">A FAZER</h2>
          <section class="column_cards a-fazer">
            <%tasksAfazer.forEach(task =>{%>
                <section class="cards" draggable="true" contenteditable="false"><%=task.taskName%></section>
            <%})%>
            <!-- draggable="true" (Permite que possamos arrastar um elemento) -->
          </section>
        </section>

        <section class="column">
          <h2 class="column_title">EM ANDAMENTO</h2>
          <section class="column_cards em-andamento">
          <%tasksEmAndamento.forEach(task =>{%>
                <section class="cards" draggable="true" contenteditable="false"><%=task.taskName%></section>
            <%})%>
          </section>
        </section>

        <section class="column">
          <h2 class="column_title">CONCLUÍDO</h2>
          <section class="column_cards finalizado">
            <%tasksConcluidas.forEach(task =>{%>
                <section class="cards" draggable="true" contenteditable="false"><%=task.taskName%></section>
            <%})%>
            <!-- draggable="true" (Permite que possamos arrastar um elemento) -->
          </section>
        </section>
      </section>
    </main>
   
<%- include('./includes/footer')%>