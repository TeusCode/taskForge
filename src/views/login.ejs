
<%- include('./includes/header') %>
<%- include('./includes/nav') %>

<%- include('./includes/messages') %>

<main class="auth-page">

    <div class="box-form">

        <!-- LOGIN -->
        <form class="form-login" action="/login/logar" method="POST">

            <div class="auth-brand">
                <span class="auth-brand-icon">TF</span>
                <span>TASK FORGE</span>
            </div>

            <div class="auth-heading">
                <span class="auth-eyebrow">BEM-VINDO DE VOLTA</span>
                <h1>Entre na sua conta.</h1>
                <p>Continue organizando suas tarefas e projetos.</p>
            </div>

            <div class="auth-fields">

                <label class="auth-field">
                    <span>Usuário</span>
                    <input
                        type="text"
                        name="user"
                        required
                        placeholder="Digite seu usuário"
                    >
                </label>

                <label class="auth-field">
                    <span>Senha</span>
                    <input
                        type="password"
                        name="password"
                        required
                        placeholder="Digite sua senha"
                    >
                </label>

            </div>

            <button type="submit" class="auth-button">
                Entrar na plataforma
                <i class="fa-solid fa-arrow-right"></i>
            </button>

            <div class="auth-footer">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Seu espaço de trabalho, organizado e seguro.</span>
            </div>

            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        </form>
    </div>

</main>

<%- include('./includes/footer') %>
