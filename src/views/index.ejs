<%- include('./includes/header') %>
<%- include('./includes/nav') %>
<%- include('./includes/messages') %>

<main class="home-container">

    <section class="home-hero">
        <span class="home-tag">PROJETO PESSOAL</span>


        <p class="home-subtitle">
            Organização e produtividade em um só lugar.
        </p>

        <p class="home-description">
            O Task Forge é um projeto desenvolvido por um estudante
            de Engenharia de Software, com o objetivo de aprimorar
            conhecimentos e habilidades em desenvolvimento web,
            explorando tecnologias de frontend e backend.
        </p>
    </section>

    <section class="home-about">

        <h2>Conheça o Task Forge</h2>

        <p>
            Uma aplicação desenvolvida para facilitar o gerenciamento
            de tarefas, permitindo organizar atividades e acompanhar
            seu progresso de maneira simples e intuitiva.
        </p>

        <div class="home-features">

            <article class="feature-card">
                <h3>01. Criar tarefas</h3>
                <p>
                    Adicione novas atividades com título e descrição.
                </p>
            </article>

            <article class="feature-card">
                <h3>02. Organizar atividades</h3>
                <p>
                    Organize suas tarefas conforme o andamento.
                </p>
            </article>

            <article class="feature-card">
                <h3>03. Acompanhar progresso</h3>
                <p>
                    Atualize o status e acompanhe suas atividades.
                </p>
            </article>

        </div>

    </section>

</main>

<%- include('./includes/footer') %>